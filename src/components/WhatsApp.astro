---
// Widget flutuante do WhatsApp (canto inferior esquerdo). Funções em Base.astro.
---
<!-- WIDGET FLUTUANTE WHATSAPP (canto inferior esquerdo) -->
  <div class="fixed bottom-6 left-6 z-40 flex flex-col gap-3 items-start">
    <div id="wa-popup" class="hidden bg-white rounded-2xl shadow-2xl w-[330px] overflow-hidden origin-bottom-left" style="animation: wa-pop .25s cubic-bezier(.2,.7,.2,1.05) both;">
      <div class="bg-[#075E54] text-white px-4 py-3.5 flex items-center gap-3 relative">
        <div class="w-11 h-11 rounded-full bg-white shrink-0 flex items-center justify-center overflow-hidden">
          <img src="/i9c-logo.png" alt="i9c" class="w-9 h-auto object-contain" />
        </div>
        <div class="flex-1 min-w-0">
          <div class="font-semibold text-sm leading-tight">i9c · Operadora Móvel</div>
          <div class="text-[11px] text-white/80 flex items-center gap-1.5 mt-0.5">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            Online · Responde em minutos
          </div>
        </div>
        <button onclick="toggleWhatsApp()" aria-label="Fechar" class="text-white/80 hover:text-white shrink-0 -mr-1">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div class="px-4 py-5 relative" style="background-color:#ECE5DD; background-image: url(&quot;data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='40' height='40' opacity='0.06'><path d='M0 20 L20 0 L40 20 L20 40 Z' fill='%23000'/></svg>&quot;);">
        <div class="bg-white rounded-2xl rounded-tl-sm p-3 shadow-sm max-w-[88%] relative">
          <div class="text-xs font-semibold text-i9c-azul mb-1">Atendimento i9c</div>
          <p class="text-sm text-ivm-azul leading-snug">Olá! 👋 Sou do atendimento da i9c. Posso ajudar com planos, portabilidade, recarga ou cobertura?</p>
          <div class="text-[10px] text-cinza/70 text-right mt-1.5">agora</div>
        </div>
      </div>
      <div class="bg-white px-4 py-4 border-t border-cinza-200">
        <p class="text-[11px] text-cinza font-mono uppercase tracking-wider mb-2">Sua mensagem inicial:</p>
        <div class="bg-cinza-50 border border-cinza-200 rounded-lg px-3 py-2.5 text-[13px] text-ivm-azul mb-3 italic leading-snug">"Falar pelo WhatsApp, gostaria de receber mais informações. Pode me Ajudar?"</div>
        <a href="https://wa.me/558008000900?text=Falar%20pelo%20WhatsApp%2C%20gostaria%20de%20receber%20mais%20informa%C3%A7%C3%B5es.%20Pode%20me%20Ajudar%3F" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold py-3 rounded-full hover:brightness-95 transition-all">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          Falar pelo WhatsApp
        </a>
        <p class="text-[10px] text-cinza/70 text-center mt-2.5">0800 800 0900 · atendimento gratuito</p>
      </div>
    </div>
    <button onclick="toggleWhatsApp()" aria-label="Conversar no WhatsApp" class="group flex items-center gap-2 bg-[#25D366] text-white pl-4 pr-5 h-12 rounded-full shadow-xl hover:brightness-95 transition-all hover:scale-105">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
      <span class="text-sm font-semibold hidden sm:inline">WhatsApp</span>
    </button>
  </div>
