---
// "Continue navegando": no fim do <main> de toda página, 3 páginas relacionadas + referências externas.
// O mapa fica em src/data/continue-navegando.ts. Página fora do mapa não ganha o bloco (e o teste acusa).
import { blocoDe, paginaDoCaminho } from '../data/continue-navegando';

const achada = paginaDoCaminho(Astro.url.pathname);
const bloco = achada && blocoDe(achada.id, achada.idioma);

const TEXTOS = {
  'pt-br': { titulo: 'Continue navegando', referencias: 'Referências e links úteis', novaAba: '(abre em nova aba)' },
  en: { titulo: 'Keep browsing', referencias: 'References and useful links', novaAba: '(opens in a new tab)' },
  es: { titulo: 'Sigue navegando', referencias: 'Referencias y enlaces útiles', novaAba: '(se abre en una pestaña nueva)' },
} as const;
const t = achada && TEXTOS[achada.idioma];
---
{bloco && t && (
  <section class="py-14 lg:py-16 bg-cinza-50 border-t border-cinza-200" aria-labelledby="continue-navegando" data-continue-navegando>
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <h2 id="continue-navegando" class="font-display font-bold text-2xl lg:text-3xl tracking-tightest text-ivm-azul">{t.titulo}</h2>
      <ul class="mt-6 grid gap-4 md:grid-cols-3">
        {bloco.internas.map((p) => (
          <li>
            <a href={p.href} class="group block h-full rounded-2xl border border-cinza-200 bg-white p-5 hover:border-i9c-azul transition-colors">
              <span class="block font-semibold text-ivm-azul group-hover:underline underline-offset-4">{p.titulo} <span aria-hidden="true" class="ml-1 text-laranja-dark">→</span></span>
              <span class="block mt-2 text-sm text-cinza leading-relaxed">{p.resumo}</span>
            </a>
          </li>
        ))}
      </ul>
      <h3 class="mt-10 font-mono text-xs font-semibold uppercase tracking-widest text-cinza">{t.referencias}</h3>
      <ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2 text-sm">
        {bloco.externas.map((e) => (
          <li><a href={e.href} target="_blank" rel="noopener" class="text-i9c-azulDark underline underline-offset-4 hover:text-ivm-azul">{e.rotulo} <span aria-hidden="true" class="ml-1">↗</span><span class="sr-only"> {t.novaAba}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
)}
