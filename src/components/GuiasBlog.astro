---
/**
 * Guias do cluster (padrão do voipmundo-site): entradas do blog cujo `pilar` é esta página.
 * Fecha o link pilar → artigo; o artigo → pilar já está no texto de cada post.
 * Usado nas páginas-pilar em português (planos-empresas, planos-pre-pago, portabilidade, recargas, mapa-de-cobertura).
 */
import { postsPublicados, hrefDo, fmtData, isoData, CATEGORIAS } from '../data/blog';

interface Props {
  pilar: string;   // ex.: '/planos-empresas.html'
  titulo: string;  // h2: "Guias sobre planos para empresas"
}
const { pilar, titulo } = Astro.props;
const guias = (await postsPublicados()).filter((p) => p.data.pilar === pilar).slice(0, 3);
---

{guias.length > 0 && (
  <section class="bg-cinza-50 border-t border-cinza-200 py-12 lg:py-16" id="guias" aria-labelledby="guias-titulo">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <div class="font-mono text-xs font-semibold uppercase tracking-widest text-laranja">Guias do blog</div>
      <h2 id="guias-titulo" class="font-display font-bold text-2xl lg:text-3xl tracking-tightest text-ivm-azul mt-2">{titulo}</h2>
      <ul class="grid gap-5 md:grid-cols-3 mt-6">
        {guias.map((g) => (
          <li>
            <a href={hrefDo(g)} class="group h-full flex flex-col rounded-3xl border border-cinza-200 bg-white p-6 hover:border-i9c-azul transition">
              <span class="flex items-center justify-between gap-3 font-mono text-xs">
                <span class="font-semibold uppercase tracking-widest text-laranja">{CATEGORIAS[g.data.categoria]}</span>
                <time class="text-cinza" datetime={isoData(g.data.publicado)}>{fmtData(g.data.publicado)}</time>
              </span>
              <span class="font-display font-bold text-lg leading-snug text-ivm-azul mt-2 group-hover:text-i9c-azul">{g.data.titulo}</span>
              <span class="text-cinza text-sm mt-2">{g.data.resumo}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6"><a href="/blog/" class="text-i9c-azul font-semibold hover:underline">Ver todos os artigos do blog</a></p>
    </div>
  </section>
)}
