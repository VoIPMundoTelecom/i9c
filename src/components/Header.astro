---
/**
 * Barra superior + header com menu mobile e seletor de idioma (PT/EN/ES).
 * Antes: o <nav> era `hidden md:flex` e não havia botão de menu (abaixo de 768px não tinha navegação).
 * O seletor leva para a página equivalente (src/i18n/rotas.ts); sem equivalente, para a home do idioma.
 */
import { IDIOMAS, HREFLANG, NOME_IDIOMA, SIGLA_IDIOMA, linkIdioma, type Idioma, type Rota } from '../i18n/rotas';
import { ui } from '../i18n/ui';
import { contratarUrl } from '../data/planos';

interface Props {
  active?: 'planos' | 'cobertura' | 'portabilidade' | 'recarga' | 'faq';
  idioma?: Idioma;
  rota?: Rota;
}
const { active, idioma = 'pt-br', rota } = Astro.props;
const t = ui(idioma);
const h = t.header;

const links = h.nav;
const inicio = linkIdioma('home', idioma);
const AREA_CLIENTE = 'https://app.i9c.net.br/';
// Destino em CONTRATAR_URL (src/data/planos.ts): formulário sem plano escolhido (igual nos 3 idiomas).
const CONTRATAR = contratarUrl(undefined, h.contratarMsg); // msg traduzida só vale no WhatsApp provisório
---

<!-- TOP UTILITY BAR -->
<div class="bg-cinza-100 border-b border-cinza-200 text-xs hidden sm:block">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 h-9 flex items-center gap-5">
    <a href={AREA_CLIENTE} class="text-cinza hover:text-i9c-azul inline-flex items-center gap-1.5 font-medium py-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      {h.suaConta}
    </a>
    <a href={h.recargaHref} hreflang={idioma !== 'pt-br' ? 'pt-BR' : undefined} class="text-cinza hover:text-i9c-azul inline-flex items-center gap-1.5 font-medium py-2">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 7h20v10H2z"/><path d="M2 11h20"/></svg>
      {h.recargaOnline}
    </a>
  </div>
</div>

<!-- NAV -->
<header class="sticky top-0 z-50 bg-white/85 backdrop-blur-md border-b border-cinza-200">
  <div class="max-w-7xl mx-auto px-5 lg:px-8 h-16 flex items-center justify-between gap-3">
    <a href={inicio} class="flex items-center gap-3" aria-label={h.logoAria}>
      <img src="/i9c-logo.png" alt="i9c" width="80" height="40" class="h-10 w-auto shrink-0" />
      <span class="hidden sm:block font-mono text-[10px] tracking-[0.25em] text-cinza uppercase border-l border-cinza-200 pl-3 leading-tight">{h.operadora[0]}<br />{h.operadora[1]}</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-cinza" aria-label={h.navAria}>
      {links.map((l) => (
        <a
          href={l.href}
          hreflang={l.pt ? 'pt-BR' : undefined}
          class={l.id === active ? 'text-i9c-azul font-semibold' : 'hover:text-i9c-azul transition-colors'}
          aria-current={l.id === active ? 'page' : undefined}
        >{l.label}{l.pt && <span class="ml-1 font-mono text-[10px] text-cinza/80" title={t.emPortugues}>PT<span class="sr-only"> ({t.emPortugues})</span></span>}</a>
      ))}
    </nav>
    <div class="flex items-center gap-1">
      <!-- Seletor de idioma -->
      <nav aria-label={t.idiomaRotulo} class="hidden sm:flex items-center mr-2 font-mono text-xs font-semibold">
        <ul class="flex items-center">
          {IDIOMAS.map((i) => (
            <li>
              <a
                href={linkIdioma(rota, i)}
                hreflang={HREFLANG[i]}
                lang={HREFLANG[i]}
                aria-label={NOME_IDIOMA[i]}
                aria-current={i === idioma ? 'true' : undefined}
                data-idioma={i}
                class={`inline-grid place-items-center min-w-[2.25rem] h-9 px-1.5 rounded-full ${i === idioma ? 'text-i9c-azul bg-i9c-azulSoft' : 'text-cinza hover:text-i9c-azul'}`}
              >{SIGLA_IDIOMA[i]}</a>
            </li>
          ))}
        </ul>
      </nav>
      <!-- Provisório até existir o fluxo de contratação: abre o WhatsApp da i9c -->
      <a href={CONTRATAR} target="_blank" rel="noopener" data-lead="contratar" class="inline-flex items-center gap-1.5 bg-i9c-azul text-white text-sm font-semibold px-4 py-2.5 rounded-full hover:bg-i9c-azulDark transition-colors">
        {h.contratar}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <button
        type="button"
        class="md:hidden inline-grid place-items-center w-11 h-11 rounded-full text-ivm-azul hover:bg-cinza-100"
        aria-label={h.abrirMenu} aria-expanded="false" aria-controls="i9c-mnav" data-mnav-toggle
        data-abrir={h.abrirMenu} data-fechar={h.fecharMenu}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <nav id="i9c-mnav" class="md:hidden hidden border-t border-cinza-200 bg-white" aria-label={h.menuAria}>
    <div class="max-w-7xl mx-auto px-5 py-2 flex flex-col">
      {links.map((l) => (
        <a href={l.href} hreflang={l.pt ? 'pt-BR' : undefined} class={`py-3 border-b border-cinza-100 text-base ${l.id === active ? 'text-i9c-azul font-semibold' : 'text-ivm-azul'}`}>{l.label}{l.pt && <span class="ml-1 font-mono text-xs text-cinza"> (PT)<span class="sr-only"> {t.emPortugues}</span></span>}</a>
      ))}
      <a href={AREA_CLIENTE} class="py-3 border-b border-cinza-100 text-base text-ivm-azul">{h.suaConta}</a>
      <div class="py-3 flex items-center gap-2 sm:hidden" role="group" aria-label={t.idiomaRotulo}>
        <span class="text-sm text-cinza mr-1" aria-hidden="true">{t.idiomaRotulo}:</span>
        {IDIOMAS.map((i) => (
          <a
            href={linkIdioma(rota, i)}
            hreflang={HREFLANG[i]}
            lang={HREFLANG[i]}
            aria-current={i === idioma ? 'true' : undefined}
            class={`inline-flex items-center h-11 px-3 rounded-full text-sm font-semibold ${i === idioma ? 'text-i9c-azul bg-i9c-azulSoft' : 'text-ivm-azul border border-cinza-200'}`}
          >{NOME_IDIOMA[i]}</a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var b = document.querySelector('[data-mnav-toggle]'), m = document.getElementById('i9c-mnav');
    if (!b || !m) return;
    function set(open) {
      m.classList.toggle('hidden', !open);
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      b.setAttribute('aria-label', open ? b.getAttribute('data-fechar') : b.getAttribute('data-abrir'));
    }
    b.addEventListener('click', function () { set(m.classList.contains('hidden')); });
    m.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !m.classList.contains('hidden')) { set(false); b.focus(); } });
  })();
</script>
