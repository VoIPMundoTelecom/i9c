---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import CookieBanner from '../components/CookieBanner.astro';
import organization from '../partials/_organization.head.html?raw';
import { IDIOMAS, HREFLANG, OG_LOCALE, PAGINA_404, idiomaDe, urlAbsoluta, type Rota } from '../i18n/rotas';
import { ui } from '../i18n/ui';
import { CONTRATAR, CODIGO_GIVM, PRECO_CONTRATAR } from '../data/planos';

interface Props {
  title: string;
  description: string;
  /** vazio = sem canonical e sem og:url (404 e manutenção respondem em qualquer URL). Com `rota`, sai da tabela. */
  canonical?: string;
  /** id da página em src/i18n/rotas.ts: liga hreflang (pt-BR, en, es, x-default) e o seletor de idioma */
  rota?: Rota;
  active?: 'planos' | 'cobertura' | 'portabilidade' | 'recarga' | 'faq';
  /** true = <meta robots noindex> */
  noindex?: boolean;
  /** true = página leve (404/manutenção): sem o chat do Bitrix24 (o CTA de contato já é o WhatsApp) e fontes sem bloquear a renderização */
  leve?: boolean;
  /** só a 404 da raiz: URL quebrada em /en/ ou /es/ vai para a 404 do idioma */
  trocaIdioma404?: boolean;
}
const { title, description, rota, active, noindex = false, leve = false, trocaIdioma404 = false } = Astro.props;

const idioma = idiomaDe(Astro.currentLocale);
const t = ui(idioma);
const canonical = Astro.props.canonical ?? (rota ? urlAbsoluta(rota, idioma) : undefined);

// Mesmo container do GTM da Voipmundo (decisão de 16/10/2026).
const GTM_ID = 'GTM-WPL6WQS';
---

<!doctype html>
<html lang={HREFLANG[idioma]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {trocaIdioma404 && (
      <script is:inline define:vars={{ destinos: { en: PAGINA_404.en, es: PAGINA_404.es } }}>
        // GitHub Pages só serve um 404.html: URL quebrada em /en/ ou /es/ abre a página de erro do idioma.
        // O pathname original (sem query nem hash) vai no sessionStorage para o evento e o WhatsApp de lá.
        (function () {
          var m = location.pathname.match(/^\/(en|es)(\/|$)/);
          if (!m) return;
          try {
            sessionStorage.setItem('i9c_404_origem', location.pathname.slice(0, 200));
            sessionStorage.setItem('i9c_404_ref', document.referrer ? new URL(document.referrer).host : '');
          } catch (e) {}
          location.replace(destinos[m[1]]);
        })();
      </script>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {rota && IDIOMAS.map((i) => <link rel="alternate" hreflang={HREFLANG[i]} href={urlAbsoluta(rota, i)} />)}
    {rota && <link rel="alternate" hreflang="x-default" href={urlAbsoluta(rota, 'pt-br')} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <!-- Google Search Console (conta marketing@grupoivm.com.br) -->
    <meta name="google-site-verification" content="e89soBTv-h7gCjONFsTHJecGi0oSu6-Cn8c76oDUYAU" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="i9c" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={OG_LOCALE[idioma]} />
    {rota && IDIOMAS.filter((i) => i !== idioma).map((i) => <meta property="og:locale:alternate" content={OG_LOCALE[i]} />)}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta name="theme-color" content="#136BA2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {!leve ? (
      <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    ) : (
      <Fragment>
        <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript><link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" /></noscript>
      </Fragment>
    )}

    <Fragment set:html={organization} />
    <slot name="head" />

    <!-- Consentimento (LGPD) + GTM: nada de medição antes do "Aceitar todos" -->
    <script is:inline define:vars={{ gtmId: GTM_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: 'denied' });
      function loadGTM() {
        if (!gtmId || window.__gtmLoaded) return;
        window.__gtmLoaded = true;
        (function (w, d, s, l, i) {
          w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      }
      window.__i9cGrant = function () {
        gtag('consent', 'update', { ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted', analytics_storage: 'granted' });
        loadGTM();
      };
      try { if (localStorage.getItem('i9c_cookies') === 'accept') window.__i9cGrant(); } catch (e) {}
    </script>
  </head>

  <body class="bg-white antialiased overflow-x-hidden">
    <a href="#conteudo" class="skip-link">{t.pular}</a>
    <WhatsApp idioma={idioma} />
    <CookieBanner idioma={idioma} />
    <Header active={active} idioma={idioma} rota={rota} />
    {t.avisoBrasil && (
      <p class="bg-i9c-azulSoft text-ivm-azul text-sm text-center px-5 py-2.5" data-aviso-brasil>{t.avisoBrasil}</p>
    )}
    <main id="conteudo">
      <slot />
    </main>
    <Footer idioma={idioma} rota={rota} />
    <slot name="end" />

    <script is:inline>
      function toggleWhatsApp() {
        var popup = document.getElementById('wa-popup');
        if (popup) popup.classList.toggle('hidden');
      }
      document.addEventListener('click', function (e) {
        var popup = document.getElementById('wa-popup');
        if (!popup || popup.classList.contains('hidden')) return;
        if (e.target.closest('#wa-popup') || e.target.closest('[onclick*="toggleWhatsApp"]')) return;
        popup.classList.add('hidden');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { var p = document.getElementById('wa-popup'); if (p) p.classList.add('hidden'); }
      });
    </script>

    <!-- GA4 begin_checkout em todo botão "Contratar" (data-lead="contratar"; data-plano = id de CONTRATAR). Só com consentimento.
         value = preço do card (PRECO_CONTRATAR) em todos os planos; plano_codigo = código do givm quando o de-para tiver. -->
    <script is:inline define:vars={{ nomes: CONTRATAR, precos: PRECO_CONTRATAR, codigos: CODIGO_GIVM }}>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-lead="contratar"]');
        if (!a) return;
        try { if (localStorage.getItem('i9c_cookies') !== 'accept') return; } catch (err) { return; }
        var id = a.getAttribute('data-plano') || '';
        var ev = { event: 'begin_checkout', plano: id || '(sem plano)' };
        if (id && nomes[id]) {
          if (codigos[id]) ev.plano_codigo = codigos[id];
          ev.ecommerce = {
            currency: 'BRL',
            value: precos[id],
            items: [{ item_id: id, item_name: nomes[id], item_brand: 'i9c', price: precos[id], quantity: 1 }],
          };
        }
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push(ev);
      });
    </script>

    <!-- Bitrix24 — chat widget oficial -->
    {!leve && <script is:inline>
      (function (w, d, u) {
        var s = d.createElement('script'); s.async = true; s.src = u + '?' + (Date.now() / 60000 | 0);
        var h = d.getElementsByTagName('script')[0]; h.parentNode.insertBefore(s, h);
      })(window, document, 'https://cdn.bitrix24.com.br/b25756911/crm/site_button/loader_4_4suya7.js');
    </script>}
  </body>
</html>
