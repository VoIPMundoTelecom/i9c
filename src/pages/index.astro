---
// Gerado a partir do index.html (site estático). Conteúdo da página em src/partials/index.*.html
import Base from '../layouts/Base.astro';
import { aplicarPlanos } from '../data/planos';
import head from '../partials/index.head.html?raw';
import body from '../partials/index.body.html?raw';
import end from '../partials/index.end.html?raw';

const title = "Operadora Móvel 5G sem Fidelidade: Planos a partir de R$ 13,99 | i9c";
const description = "Planos pré-pago, controle, família e empresas com 5G nacional e ligações ilimitadas. Sem fidelidade, contratação online. Operadora autorizada ANATEL.";
const canonical = "https://i9c.net.br/";
---

<Base title={title} description={description} canonical={canonical} active="planos">
  <Fragment slot="head" set:html={aplicarPlanos(head)} />
  <Fragment set:html={aplicarPlanos(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
