---
// Gerado a partir do planos-controle.html (site estático). Conteúdo da página em src/partials/planos-controle.*.html
import Base from '../layouts/Base.astro';
import { aplicarPlanos } from '../data/planos';
import head from '../partials/planos-controle.head.html?raw';
import body from '../partials/planos-controle.body.html?raw';
import end from '../partials/planos-controle.end.html?raw';

const title = "Plano controle sem fidelidade e ligações ilimitadas | i9c";
const description = "Plano controle sem fidelidade e sem multa: 15GB a 80GB, ligações ilimitadas e pacote de SMS, WhatsApp grátis e 5G onde houver cobertura. Valor fixo por mês.";
const canonical = "https://i9c.net.br/planos-controle.html";
---

<Base title={title} description={description} canonical={canonical} rota="planos-controle" active="planos">
  <Fragment slot="head" set:html={aplicarPlanos(head)} />
  <Fragment set:html={aplicarPlanos(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
