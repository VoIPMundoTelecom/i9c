---
// Gerado a partir do planos-controle.html (site estático). Conteúdo da página em src/partials/planos-controle.*.html
import Base from '../layouts/Base.astro';
import head from '../partials/planos-controle.head.html?raw';
import body from '../partials/planos-controle.body.html?raw';
import end from '../partials/planos-controle.end.html?raw';

const title = "Plano controle 5G com ligações ilimitadas, sem fidelidade | i9c";
