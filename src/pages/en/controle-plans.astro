---
// Tradução (en) de src/pages/planos-controle.astro. Conteúdo em src/partials/en/planos-controle.*.html
import Base from '../../layouts/Base.astro';
import { aplicarI18n } from '../../i18n/aplicar';
import head from '../../partials/en/planos-controle.head.html?raw';
import body from '../../partials/en/planos-controle.body.html?raw';
import end from '../../partials/en/planos-controle.end.html?raw';

const title = "Controle plan with unlimited calls and 5G in Brazil | i9c";
const description = "i9c Controle plans for Brazilian lines: 15GB to 80GB, unlimited calls, free WhatsApp and 5G where available. A fixed monthly price and no contract.";
---

<Base title={title} description={description} rota="planos-controle" active="planos">
  <Fragment slot="head" set:html={aplicarI18n(head)} />
  <Fragment set:html={aplicarI18n(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
