---
// Tradução (en) de src/pages/planos-familia.astro. Conteúdo em src/partials/en/planos-familia.*.html
import Base from '../../layouts/Base.astro';
import { aplicarI18n } from '../../i18n/aplicar';
import head from '../../partials/en/planos-familia.head.html?raw';
import body from '../../partials/en/planos-familia.body.html?raw';
import end from '../../partials/en/planos-familia.end.html?raw';

const title = "Family plan with 2 to 6 lines and 5G in Brazil | i9c";
const description = "i9c family plans for Brazilian lines: 15GB to 230GB shared across up to 6 lines, with unlimited calls and free apps. Nationwide 5G, no contract.";
---

<Base title={title} description={description} rota="planos-familia" active="planos">
  <Fragment slot="head" set:html={aplicarI18n(head)} />
  <Fragment set:html={aplicarI18n(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
