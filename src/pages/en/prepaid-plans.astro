---
// Tradução (en) de src/pages/planos-pre-pago.astro. Conteúdo em src/partials/en/planos-pre-pago.*.html
import Base from '../../layouts/Base.astro';
import { aplicarI18n } from '../../i18n/aplicar';
import head from '../../partials/en/planos-pre-pago.head.html?raw';
import body from '../../partials/en/planos-pre-pago.body.html?raw';
import end from '../../partials/en/planos-pre-pago.end.html?raw';

const title = "Prepaid 5G SIM in Brazil from R$ 13,99, no contract | i9c";
const description = "i9c prepaid plans for Brazilian mobile lines with WhatsApp, Instagram and Facebook, from R$ 13,99 (WhatsApp only) to 30GB. 5G where available, no contract.";
---

<Base title={title} description={description} rota="planos-pre-pago" active="planos">
  <Fragment slot="head" set:html={aplicarI18n(head)} />
  <Fragment set:html={aplicarI18n(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
