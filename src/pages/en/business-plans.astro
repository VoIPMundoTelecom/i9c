---
// Tradução (en) de src/pages/planos-empresas.astro. Conteúdo em src/partials/en/planos-empresas.*.html
import Base from '../../layouts/Base.astro';
import { aplicarI18n } from '../../i18n/aplicar';
import head from '../../partials/en/planos-empresas.head.html?raw';
import body from '../../partials/en/planos-empresas.body.html?raw';
import end from '../../partials/en/planos-empresas.end.html?raw';

const title = "Business mobile plans with line management | i9c";
const description = "Business mobile lines in Brazil, 3GB to 160GB, for companies and public agencies: voice and data management, free Outlook and Waze. No contract.";
---

<Base title={title} description={description} rota="planos-empresas" active="planos">
  <Fragment slot="head" set:html={aplicarI18n(head)} />
  <Fragment set:html={aplicarI18n(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
