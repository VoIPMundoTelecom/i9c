---
// Gerado a partir do portabilidade.html (site estático). Conteúdo da página em src/partials/portabilidade.*.html
import Base from '../layouts/Base.astro';
import head from '../partials/portabilidade.head.html?raw';
import body from '../partials/portabilidade.body.html?raw';
import end from '../partials/portabilidade.end.html?raw';

const title = "Portabilidade · i9c";
const description = "Traga seu número para a i9c. Portabilidade móvel gratuita, sem ficar sem sinal e sem fidelidade.";
const canonical = "https://i9c.net.br/portabilidade.html";
---

<Base title={title} description={description} canonical={canonical} active="portabilidade">
  <Fragment slot="head" set:html={head} />
  <Fragment set:html={body} />
  <Fragment slot="end" set:html={end} />
</Base>
