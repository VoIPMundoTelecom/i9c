---
// Gerado a partir do planos-familia.html (site estático). Conteúdo da página em src/partials/planos-familia.*.html
import Base from '../layouts/Base.astro';
import { aplicarPlanos } from '../data/planos';
import head from '../partials/planos-familia.head.html?raw';
import body from '../partials/planos-familia.body.html?raw';
import end from '../partials/planos-familia.end.html?raw';

const title = "Plano família com 2 a 6 linhas e 5G, sem fidelidade | i9c";
const description = "Planos família i9c de 15GB a 230GB compartilhados entre até 6 linhas, com ligações ilimitadas e apps grátis. 5G nacional e sem fidelidade.";
const canonical = "https://i9c.net.br/planos-familia.html";
---

<Base title={title} description={description} canonical={canonical} active="planos">
  <Fragment slot="head" set:html={aplicarPlanos(head)} />
  <Fragment set:html={aplicarPlanos(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
