---
// Tradução (es) de src/pages/planos-empresas.astro. Conteúdo em src/partials/es/planos-empresas.*.html
import Base from '../../layouts/Base.astro';
import { aplicarI18n } from '../../i18n/aplicar';
import head from '../../partials/es/planos-empresas.head.html?raw';
import body from '../../partials/es/planos-empresas.body.html?raw';
import end from '../../partials/es/planos-empresas.end.html?raw';

const title = "Planes móviles para empresas con gestión de líneas | i9c";
const description = "Líneas móviles en Brasil para empresas y organismos públicos, de 3GB a 160GB, con gestión de voz y datos, Outlook y Waze gratis. Sin permanencia.";
---

<Base title={title} description={description} rota="planos-empresas" active="planos">
  <Fragment slot="head" set:html={aplicarI18n(head)} />
  <Fragment set:html={aplicarI18n(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
