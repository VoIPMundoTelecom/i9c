---
// Tradução (es) de src/pages/planos-pre-pago.astro. Conteúdo em src/partials/es/planos-pre-pago.*.html
import Base from '../../layouts/Base.astro';
import { aplicarI18n } from '../../i18n/aplicar';
import head from '../../partials/es/planos-pre-pago.head.html?raw';
import body from '../../partials/es/planos-pre-pago.body.html?raw';
import end from '../../partials/es/planos-pre-pago.end.html?raw';

const title = "Prepago 5G en Brasil desde R$ 13,99, sin permanencia | i9c";
const description = "Planes prepago i9c en Brasil con WhatsApp, Instagram y Facebook, desde R$ 13,99 (solo WhatsApp) hasta 30GB. 5G donde haya cobertura, sin permanencia.";
---

<Base title={title} description={description} rota="planos-pre-pago" active="planos">
  <Fragment slot="head" set:html={aplicarI18n(head)} />
  <Fragment set:html={aplicarI18n(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
