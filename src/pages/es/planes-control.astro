---
// Tradução (es) de src/pages/planos-controle.astro. Conteúdo em src/partials/es/planos-controle.*.html
import Base from '../../layouts/Base.astro';
import { aplicarI18n } from '../../i18n/aplicar';
import head from '../../partials/es/planos-controle.head.html?raw';
import body from '../../partials/es/planos-controle.body.html?raw';
import end from '../../partials/es/planos-controle.end.html?raw';

const title = "Plan Control 5G con llamadas ilimitadas en Brasil | i9c";
const description = "Planes Control i9c para líneas en Brasil: de 15GB a 80GB, llamadas ilimitadas, WhatsApp gratis y 5G nacional. Precio fijo al mes y sin permanencia.";
---

<Base title={title} description={description} rota="planos-controle" active="planos">
  <Fragment slot="head" set:html={aplicarI18n(head)} />
  <Fragment set:html={aplicarI18n(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
