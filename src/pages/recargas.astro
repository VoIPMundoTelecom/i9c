---
// Gerado a partir do recargas.html (site estático). Conteúdo da página em src/partials/recargas.*.html
import Base from '../layouts/Base.astro';
import head from '../partials/recargas.head.html?raw';
import body from '../partials/recargas.body.html?raw';
import end from '../partials/recargas.end.html?raw';

const title = "Recargas · i9c";
const description = "Recarregue sua linha i9c. Nova área de recargas em construção; recarga já disponível pelo parceiro.";
const canonical = "https://i9c.net.br/recargas.html";
---

<Base title={title} description={description} canonical={canonical} active="recarga">
  <Fragment slot="head" set:html={head} />
  <Fragment set:html={body} />
  <Fragment slot="end" set:html={end} />
</Base>
