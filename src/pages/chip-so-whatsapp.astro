import Base from '../layouts/Base.astro';
import head from '../partials/chip-so-whatsapp.head.html?raw';
import body from '../partials/chip-so-whatsapp.body.html?raw';

const title = "Chip só WhatsApp: para quem serve e quanto custa · i9c";
