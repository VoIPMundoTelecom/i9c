---
// Gerado a partir do planos-pre-pago.html (site estático). Conteúdo da página em src/partials/planos-pre-pago.*.html
import Base from '../layouts/Base.astro';
import { aplicarPlanos } from '../data/planos';
import head from '../partials/planos-pre-pago.head.html?raw';
import body from '../partials/planos-pre-pago.body.html?raw';
import end from '../partials/planos-pre-pago.end.html?raw';

const title = "Chip pré-pago 5G a partir de R$ 13,99, sem fidelidade | i9c";
const description = "Planos pré-pago i9c com WhatsApp, Instagram e Facebook, de R$ 13,99 (só WhatsApp) a 30GB. 5G nacional, recarga online e sem fidelidade.";
const canonical = "https://i9c.net.br/planos-pre-pago.html";
---

<Base title={title} description={description} canonical={canonical} active="planos">
  <Fragment slot="head" set:html={aplicarPlanos(head)} />
  <Fragment set:html={aplicarPlanos(body)} />
  <Fragment slot="end" set:html={end} />
</Base>
