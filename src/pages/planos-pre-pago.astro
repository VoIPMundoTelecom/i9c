---
// Gerado a partir do planos-pre-pago.html (site estático). Conteúdo da página em src/partials/planos-pre-pago.*.html
import Base from '../layouts/Base.astro';
import GuiasBlog from '../components/GuiasBlog.astro';
import { aplicarPlanos, formatarPreco, menorPreco, PRECO_CONTRATAR } from '../data/planos';
import head from '../partials/planos-pre-pago.head.html?raw';
import body from '../partials/planos-pre-pago.body.html?raw';
import end from '../partials/planos-pre-pago.end.html?raw';

const title = `Chip pré-pago 5G a partir de ${formatarPreco(menorPreco('prepago'))}, sem fidelidade | i9c`;
const description = `Planos pré-pago i9c com WhatsApp, Instagram e Facebook, de ${formatarPreco(menorPreco('prepago'))} a 30GB, e o só WhatsApp por ${formatarPreco(PRECO_CONTRATAR['prepago-whatsapp'])}. 5G onde houver cobertura e sem fidelidade.`;
const canonical = "https://i9c.net.br/planos-pre-pago.html";
---

<Base title={title} description={description} canonical={canonical} rota="planos-pre-pago" active="planos">
  <Fragment slot="head" set:html={aplicarPlanos(head)} />
  <Fragment set:html={aplicarPlanos(body)} />
  <GuiasBlog pilar="/planos-pre-pago.html" titulo="Guias sobre o pré-pago" />
  <Fragment slot="end" set:html={end} />
</Base>
