---
// Gerado a partir do planos-empresas.html (site estático). Conteúdo da página em src/partials/planos-empresas.*.html
import Base from '../layouts/Base.astro';
import GuiasBlog from '../components/GuiasBlog.astro';
import { aplicarPlanos } from '../data/planos';
import head from '../partials/planos-empresas.head.html?raw';
import body from '../partials/planos-empresas.body.html?raw';
import end from '../partials/planos-empresas.end.html?raw';

const title = "Plano móvel empresarial com gestão de linhas | i9c";
const description = "Plano móvel empresarial i9c: linhas de 3GB a 160GB para empresas e órgãos públicos, com gestão de voz e dados, Outlook e Waze grátis. 5G onde houver cobertura e sem fidelidade.";
const canonical = "https://i9c.net.br/planos-empresas.html";
---

<Base title={title} description={description} canonical={canonical} rota="planos-empresas" active="planos">
  <Fragment slot="head" set:html={aplicarPlanos(head)} />
  <Fragment set:html={aplicarPlanos(body)} />
  <GuiasBlog pilar="/planos-empresas.html" titulo="Guias sobre linhas para empresas" />
  <Fragment slot="end" set:html={end} />
</Base>
